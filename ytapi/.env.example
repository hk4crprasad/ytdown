# ─── Server ──────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ─── Cloudflare Turnstile (bot protection) ────────────
# Get your secret key from dash.cloudflare.com → Turnstile
# Leave empty to disable verification in local dev.
TURNSTILE_SECRET_KEY=0x4AAAAAADQ3f17BuDSkw4NhWWcKVU5Zt08

# ─── Token ───────────────────────────────────────────
# Absolute or relative path to your tokens.json file.
TOKEN_FILE=./tokens.json

# ─── CORS ────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all.
CORS_ORIGINS=["*"]

# ─── Storage ─────────────────────────────────────────
DOWNLOAD_DIR=./downloads
TEMP_DIR=./temp

# ─── Streaming ───────────────────────────────────────
CHUNK_SIZE=524288
STREAM_TIMEOUT=30

# ─── pytubefix client ────────────────────────────────
# Available: WEB, IOS, ANDROID, TV, MWEB, ...
DEFAULT_CLIENT=IOS
